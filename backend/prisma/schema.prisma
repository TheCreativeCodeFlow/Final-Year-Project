// ==============================================================================
// Adaptive Deception Gateway - Prisma Domain Schema
// Stage 3B: PostgreSQL Relational Models with Strict Tenant Isolation
// ==============================================================================

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ------------------------------------------------------------------------------
// A. Organization & Tenancy
// ------------------------------------------------------------------------------

model Tenant {
  id          String   @id @default(uuid())
  identifier  String   @unique // e.g. "tenant-apex-9941", "tenant-medsecure-7712"
  displayName String
  status      String   @default("ACTIVE") // ACTIVE, SUSPENDED, DECOMMISSIONED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  applications           ProtectedApplication[]
  policies               DeceptionPolicy[]
  strategies             DeceptionStrategy[]
  environments           DeceptionEnvironment[]
  investigations         Investigation[]
  attackerProfiles       AttackerProfile[]
  investigationProfiles  InvestigationAttackerProfile[]
  securityObservations   SecurityObservation[]
  behavioralAssessments  BehavioralAssessment[]
  policyDecisions        PolicyDecision[]
  routingDecisions       RoutingDecision[]
  routingOutcomes        RoutingOutcome[]
  executionEvidences     ExecutionEvidence[]
  graphs                 DeceptionGraph[]
  graphTransitions       DeceptionGraphTransition[]
  auditEvents            AuditEvent[]
  memberships            TenantMembership[]
  behavioralFeatureSets  BehavioralFeatureSet[]
  behavioralBaselines    BehavioralBaseline[]
  detectionModelVersions DetectionModelVersion[]
  modelTrainingRuns      ModelTrainingRun[]
  detectionRuleVersions  DetectionRuleVersion[]
  executionAuthorizations DeceptionExecutionAuthorization[]
  runtimeEnvironments     DeceptionRuntimeEnvironment[]
  executionEvents         DeceptionExecutionEvent[]
  resourceQuotas          DeceptionResourceQuota[]
  runtimeMutations        DeceptionRuntimeMutation[]

  @@map("tenants")
}

// ------------------------------------------------------------------------------
// B. Protected Applications
// ------------------------------------------------------------------------------

model ProtectedApplication {
  id                    String   @id @default(uuid())
  tenantId              String
  applicationIdentifier String // e.g. "app-01", "app-14"
  name                  String // e.g. "Customer Accounts API"
  domain                String // e.g. "accounts.apexfintech.internal"
  status                String   @default("PROTECTED") // PROTECTED, DEGRADED, BYPASS
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  tenant                 Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  investigations         Investigation[]
  observations           SecurityObservation[]
  routingDecisions       RoutingDecision[]
  behavioralAssessments  BehavioralAssessment[]
  behavioralFeatureSets  BehavioralFeatureSet[]
  behavioralBaselines    BehavioralBaseline[]
  detectionModelVersions DetectionModelVersion[]
  modelTrainingRuns      ModelTrainingRun[]
  deceptionPolicies      DeceptionPolicy[]
  policyDecisions        PolicyDecision[]
  deceptionGraphs        DeceptionGraph[]
  executionAuthorizations DeceptionExecutionAuthorization[]
  runtimeEnvironments     DeceptionRuntimeEnvironment[]
  resourceQuotas          DeceptionResourceQuota[]

  @@unique([id, tenantId])
  @@unique([tenantId, applicationIdentifier])
  @@index([tenantId])
  @@map("protected_applications")
}

// ------------------------------------------------------------------------------
// C. Deception Policies
// ------------------------------------------------------------------------------

model DeceptionPolicy {
  id                            String   @id @default(uuid())
  tenantId                      String? // Null indicates platform-wide baseline policy
  applicationId                 String? // Null indicates all applications within tenant
  policyIdentifier              String // e.g. "pol-sec-01", "pol-sec-06"
  name                          String
  description                   String?
  enabled                       Boolean  @default(true)
  priority                      Int      @default(100) // 1 (highest) to 1000 (lowest)
  version                       Int      @default(1)
  triggerConditions             Json // Structured conditions e.g. { pathPrefix: "/api/v1/admin" }
  requiredEvidenceCriteria      Json // Thresholds e.g. { minConfidence: 0.8, requiresCanaryHit: true }
  permittedActions              Json // e.g. ["DIVERSION", "CONTAINMENT", "DELAY"]
  prohibitedActions             Json // e.g. ["RUN_ARBITRARY_COMMAND", "EXFILTRATE_DATA"]
  protectedIsolationConstraints Json // e.g. { strictNamespaceIsolation: true, noOutboundEgress: true }
  createdAt                     DateTime @default(now())
  updatedAt                     DateTime @updatedAt

  tenant      Tenant?               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  application ProtectedApplication? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  decisions   PolicyDecision[]

  @@unique([policyIdentifier, version])
  @@index([tenantId])
  @@index([applicationId])
  @@index([priority])
  @@map("deception_policies")
}

// ------------------------------------------------------------------------------
// D. Deception Strategies
// ------------------------------------------------------------------------------

model DeceptionStrategy {
  id                           String   @id @default(uuid())
  tenantId                     String? // Null indicates platform-wide strategy
  strategyIdentifier           String   @unique // e.g. "strat-contain-06", "strat-tarpit-02"
  name                         String
  description                  String?
  strategyType                 String // "CONTAINMENT", "TARPIT", "HONEYPOT_DIVERSION", "CANARY_INJECTION", or Stage 5A categories
  enabled                      Boolean  @default(true)
  version                      Int      @default(1)
  prerequisites                Json // Structured prerequisites
  permittedStateChangeProposal Json // Structured state-change proposal (NO arbitrary code/commands)
  isolationRequirements        Json // Required sandbox isolation boundaries
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt

  tenant    Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  decisions PolicyDecision[]

  @@index([tenantId])
  @@map("deception_strategies")
}

// ------------------------------------------------------------------------------
// E. Deception Environments
// ------------------------------------------------------------------------------

model DeceptionEnvironment {
  id                     String   @id @default(uuid())
  tenantId               String
  environmentIdentifier  String // e.g. "env-apex-sandbox-01", "env-medsecure-tarpit"
  name                   String
  description            String?
  lifecycleState         String   @default("ACTIVE") // PROVISIONING, ACTIVE, DRAINING, TERMINATED
  isolationConfiguration Json // Network namespace, egress policy, cpu/memory limits
  metadata               Json? // Synthetic service blueprints and version metadata
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  graphs           DeceptionGraph[]
  routingDecisions RoutingDecision[]

  @@unique([id, tenantId])
  @@unique([tenantId, environmentIdentifier])
  @@index([tenantId])
  @@map("deception_environments")
}

// ------------------------------------------------------------------------------
// F. Investigations & Attacker Behavior Profiles
// ------------------------------------------------------------------------------

model Investigation {
  id                      String   @id @default(uuid())
  tenantId                String
  applicationId           String?
  investigationIdentifier String // e.g. "inv-801", "inv-804", "inv-806"
  status                  String   @default("OPEN") // OPEN, IN_REVIEW, CLOSED, DISCREPANCY_FLAGGED
  severity                String   @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  summary                 String
  evidenceReferences      Json? // Structured references to observed facts and external correlation
  openedAt                DateTime @default(now())
  updatedAt               DateTime @updatedAt

  tenant                Tenant                         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  application           ProtectedApplication?          @relation(fields: [applicationId, tenantId], references: [id, tenantId], onDelete: Cascade)
  attackerProfiles      InvestigationAttackerProfile[]
  observations          SecurityObservation[]
  behavioralAssessments BehavioralAssessment[]

  @@unique([id, tenantId])
  @@unique([tenantId, investigationIdentifier])
  @@index([tenantId])
  @@map("investigations")
}

model AttackerProfile {
  id                         String    @id @default(uuid())
  tenantId                   String
  profileIdentifier          String // e.g. "prof-701", "prof-704"
  displayLabel               String // Pseudonymous label: preserves uncertainty (not verified real identity)
  observedBehaviorIndicators Json // Indicators, heuristics, and observed TTP signatures
  firstSeenAt                DateTime?
  lastSeenAt                 DateTime?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  tenant         Tenant                         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  investigations InvestigationAttackerProfile[]

  @@unique([id, tenantId])
  @@unique([tenantId, profileIdentifier])
  @@index([tenantId])
  @@map("attacker_profiles")
}

model InvestigationAttackerProfile {
  id                String   @id @default(uuid())
  tenantId          String
  investigationId   String
  attackerProfileId String
  associatedAt      DateTime @default(now())

  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  investigation   Investigation   @relation(fields: [investigationId, tenantId], references: [id, tenantId], onDelete: Cascade)
  attackerProfile AttackerProfile @relation(fields: [attackerProfileId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@unique([investigationId, attackerProfileId])
  @@index([tenantId])
  @@map("investigation_attacker_profiles")
}

// ------------------------------------------------------------------------------
// G. Gateway Observations & Decision Lifecycle
// (Strict semantic separation across observation, assessment, decision, outcome, evidence)
// ------------------------------------------------------------------------------

model SecurityObservation {
  id                          String   @id @default(uuid())
  tenantId                    String
  applicationId               String?
  investigationId             String?
  observationIdentifier       String   @unique // e.g. "obs-901"
  observationType             String // e.g. "CANARY_TOKEN_TRIGGER", "PATH_TRAVERSAL_PROBE"
  observedAt                  DateTime @default(now())
  sanitizedStructuredEvidence Json // Sanitized headers, URI, method, payload metadata
  evidenceProvenance          String // e.g. "INGRESS_WAF", "EDGE_PROXY", "CANARY_SERVICE"
  correlationId               String
  evidenceStatus              String   @default("OBSERVED") // "OBSERVED", "FILTERED", "SUPPRESSED"

  tenant          Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  application     ProtectedApplication?  @relation(fields: [applicationId, tenantId], references: [id, tenantId], onDelete: Cascade)
  investigation   Investigation?         @relation(fields: [investigationId, tenantId], references: [id, tenantId], onDelete: Cascade)
  assessments     BehavioralAssessment[]
  policyDecisions PolicyDecision[]

  @@unique([id, tenantId])
  @@index([tenantId])
  @@index([correlationId])
  @@map("security_observations")
}

model BehavioralAssessment {
  id                    String   @id @default(uuid())
  tenantId              String
  applicationId         String?
  observationId         String?
  investigationId       String?
  sessionRef            String? // Correlates with BehavioralFeatureSet sessionRef
  windowLabel           String? // "30s", "5m", "15m"
  assessmentLabel       String   @default("NORMAL") // "NORMAL", "SUSPICIOUS", "HIGHLY_SUSPICIOUS", "INSUFFICIENT_EVIDENCE"
  classification        String // e.g. "CREDENTIAL_STUFFING", "ANOMALOUS_PROBE", "BENIGN_BASELINE"
  riskScore             Float? // Documented valid range [0.0, 1.0]
  confidenceScore       Float? // Documented valid range [0.0, 1.0]; NOT proof of malicious intent
  modelOrRuleVersion    String // Assessment provenance / model revision
  ruleFindings          Json? // Detailed structured findings from Branch A
  mlAnomalyResult       Json? // Detailed scores, threshold, and contributing features from Branch B
  explanation           Json? // Detailed explanation and uncertainty factors
  dataQualityState      String   @default("COMPLETE")
  telemetryLossDetected Boolean  @default(false)
  assessedAt            DateTime @default(now())

  tenant          Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  application     ProtectedApplication? @relation(fields: [applicationId, tenantId], references: [id, tenantId], onDelete: Cascade)
  observation     SecurityObservation?  @relation(fields: [observationId, tenantId], references: [id, tenantId], onDelete: Cascade)
  investigation   Investigation?        @relation(fields: [investigationId, tenantId], references: [id, tenantId], onDelete: Cascade)
  policyDecisions PolicyDecision[]

  @@unique([id, tenantId])
  @@index([tenantId])
  @@index([applicationId])
  @@index([sessionRef])
  @@index([assessmentLabel])
  @@map("behavioral_assessments")
}

model PolicyDecision {
  id                      String   @id @default(uuid())
  tenantId                String
  applicationId           String?
  observationId           String?
  assessmentId            String?
  policyId                String?
  policyVersion           Int?
  selectedStrategyId      String?
  selectedStrategyVersion Int?
  candidateStrategyIds    Json?
  dsgGraphId              String?
  proposedMutations       Json?
  reasonCodes             Json?
  evaluatorVersion        String?
  deceptionDisposition    String? // "PROPOSE_DECEPTION", "DECEPTION_NOT_PROPOSED", "DECEPTION_REJECTED"
  originAccessDecision    String? // "DEFER_TO_GATEWAY", "PROPOSE_DIVERT_TO_DECEPTION", "DENY_APPLICATION_SUSPENDED", "DEFER_WITH_UNCERTAINTY"
  baseGraphVersion        Int?
  strategyCatalogueVersion String?
  idempotencyKey          String?
  requestPayloadHash      String?
  decisionResult          String // "ALLOW_NORMAL", "BLOCK_POLICY", "INSUFFICIENT_EVIDENCE", "POLICY_NOT_CONFIGURED", "NO_ELIGIBLE_STRATEGY", "PROPOSE_DECEPTION"
  decisionRationale       String
  evidenceReferences      Json?
  decidedAt               DateTime @default(now())

  tenant           Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  application      ProtectedApplication? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  observation      SecurityObservation?  @relation(fields: [observationId, tenantId], references: [id, tenantId], onDelete: Cascade)
  assessment       BehavioralAssessment? @relation(fields: [assessmentId, tenantId], references: [id, tenantId], onDelete: Cascade)
  policy           DeceptionPolicy?      @relation(fields: [policyId], references: [id], onDelete: SetNull)
  selectedStrategy DeceptionStrategy?    @relation(fields: [selectedStrategyId], references: [id], onDelete: SetNull)
  graph            DeceptionGraph?       @relation(fields: [dsgGraphId], references: [id], onDelete: SetNull)
  routingDecisions RoutingDecision[]
  transitions      DeceptionGraphTransition[]
  executionAuthorizations DeceptionExecutionAuthorization[]

  @@unique([id, tenantId])
  @@index([tenantId])
  @@index([applicationId])
  @@index([assessmentId])
  @@index([policyId])
  @@index([selectedStrategyId])
  @@index([dsgGraphId])
  @@index([idempotencyKey])
  @@map("policy_decisions")
}

model RoutingDecision {
  id                  String   @id @default(uuid())
  tenantId            String
  policyDecisionId    String?
  intendedAction      String // "NORMAL_ROUTING", "BLOCK", "PROPOSED_DECEPTION_DIVERSION"
  targetApplicationId String?
  targetEnvironmentId String?
  correlationId       String
  decisionStatus      String   @default("DECIDED") // "DECIDED", "TRANSMITTED", "SUPERSEDED"
  decidedAt           DateTime @default(now())

  tenant            Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  policyDecision    PolicyDecision?       @relation(fields: [policyDecisionId, tenantId], references: [id, tenantId], onDelete: Cascade)
  targetApplication ProtectedApplication? @relation(fields: [targetApplicationId, tenantId], references: [id, tenantId], onDelete: Cascade)
  targetEnvironment DeceptionEnvironment? @relation(fields: [targetEnvironmentId, tenantId], references: [id, tenantId], onDelete: Cascade)
  outcome           RoutingOutcome?
  executionEvidence ExecutionEvidence?

  @@unique([id, tenantId])
  @@index([tenantId])
  @@index([correlationId])
  @@map("routing_decisions")
}

model RoutingOutcome {
  id                          String   @id @default(uuid())
  tenantId                    String
  routingDecisionId           String   @unique
  outcomeStatus               String // "DIVERTED_TO_SANDBOX", "BLOCKED_AT_INGRESS", "FAILED_UPSTREAM", "DISCREPANCY_DETECTED", "UNKNOWN"
  outcomeSource               String // Provenance e.g. "EDGE_ENVOY_PROXY", "CONTAINER_SUPERVISOR"
  recordedAt                  DateTime @default(now())
  failureOrDiscrepancyDetails Json? // Preserves recorded discrepancy vs intended routing

  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  routingDecision RoutingDecision @relation(fields: [routingDecisionId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@unique([routingDecisionId, tenantId])
  @@unique([id, tenantId])
  @@index([tenantId])
  @@map("routing_outcomes")
}

model ExecutionEvidence {
  id                String    @id @default(uuid())
  tenantId          String
  routingDecisionId String    @unique
  evidenceStatus    String // "CONFIRMED_EXECUTION", "MISSING", "INCONCLUSIVE", "EXECUTION_FAILED"
  evidenceSource    String? // null if unverified / missing
  evidenceData      Json? // null if unverified / missing
  recordedAt        DateTime? // null if unverified / missing
  correlationId     String

  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  routingDecision RoutingDecision @relation(fields: [routingDecisionId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@unique([routingDecisionId, tenantId])
  @@unique([id, tenantId])
  @@index([tenantId])
  @@index([correlationId])
  @@map("execution_evidences")
}

// ------------------------------------------------------------------------------
// H. Deception State Graph (DSG)
// ------------------------------------------------------------------------------

model DeceptionGraph {
  id              String   @id @default(uuid())
  tenantId        String
  environmentId   String?
  applicationId   String?
  graphIdentifier String // e.g. "dsg-apex-01"
  graphVersion    Int      @default(1)
  revisionId      String?  @default(uuid())
  status          String   @default("ACTIVE") // ACTIVE, DRAFT, ARCHIVED
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant          Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  environment     DeceptionEnvironment?      @relation(fields: [environmentId, tenantId], references: [id, tenantId], onDelete: Cascade)
  application     ProtectedApplication?      @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  nodes           DeceptionGraphNode[]
  edges           DeceptionGraphEdge[]
  transitions     DeceptionGraphTransition[]
  policyDecisions PolicyDecision[]
  executionAuthorizations DeceptionExecutionAuthorization[]
  runtimeEnvironments     DeceptionRuntimeEnvironment[]
  runtimeMutations        DeceptionRuntimeMutation[]

  @@unique([id, tenantId])
  @@unique([tenantId, graphIdentifier, graphVersion])
  @@index([tenantId])
  @@index([applicationId])
  @@map("deception_graphs")
}

model DeceptionGraphNode {
  id                   String   @id @default(uuid())
  graphId              String
  nodeIdentifier       String // e.g. "node-auth-decoy", "node-fake-admin"
  nodeType             String // e.g. "SYNTHETIC_API", "HONEY_CREDENTIAL", "SANDBOX_DATABASE"
  assetDescription     String
  layerClassification  String // "PROTECTED_DECEPTION_POLICY", "CONTROLLED_DYNAMIC_STATE", "OBSERVATIONAL_ATTACKER_STATE"
  structuredAttributes Json // Attributes, fake service ports, simulated response templates
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  graph         DeceptionGraph       @relation(fields: [graphId], references: [id], onDelete: Cascade)
  outgoingEdges DeceptionGraphEdge[] @relation("SourceNode")
  incomingEdges DeceptionGraphEdge[] @relation("TargetNode")

  @@unique([id, graphId])
  @@unique([graphId, nodeIdentifier])
  @@index([graphId])
  @@map("deception_graph_nodes")
}

model DeceptionGraphEdge {
  id                   String   @id @default(uuid())
  graphId              String
  sourceNodeId         String
  targetNodeId         String
  edgeType             String // e.g. "LATERAL_MOVEMENT_TRAP", "DATA_EXFIL_SINK", "DEPENDENCY"
  structuredAttributes Json
  createdAt            DateTime @default(now())

  graph      DeceptionGraph     @relation(fields: [graphId], references: [id], onDelete: Cascade)
  sourceNode DeceptionGraphNode @relation("SourceNode", fields: [sourceNodeId, graphId], references: [id, graphId], onDelete: Cascade)
  targetNode DeceptionGraphNode @relation("TargetNode", fields: [targetNodeId, graphId], references: [id, graphId], onDelete: Cascade)

  @@unique([graphId, sourceNodeId, targetNodeId, edgeType])
  @@index([graphId])
  @@map("deception_graph_edges")
}

model DeceptionGraphTransition {
  id                      String    @id @default(uuid())
  tenantId                String
  graphId                 String
  policyDecisionId        String?
  baseGraphVersion        Int?
  targetGraphVersion      Int?
  idempotencyKey          String?
  requestPayloadHash      String?
  rejectionReason         String?
  previousState           Json
  proposedState           Json
  transitionStatus        String    @default("PROPOSED") // "PROPOSED", "VALIDATED", "REJECTED"
  triggeringObservationId String?
  triggeringDecisionId    String?
  provenance              String // e.g. "ADAPTIVE_PLANNER_SIMULATION", "POLICY_EVALUATOR_STAGE_5A"
  proposedAt              DateTime  @default(now())
  resolvedAt              DateTime?

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  graph          DeceptionGraph  @relation(fields: [graphId, tenantId], references: [id, tenantId], onDelete: Cascade)
  policyDecision PolicyDecision? @relation(fields: [policyDecisionId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([graphId])
  @@index([policyDecisionId])
  @@index([idempotencyKey])
  @@map("deception_graph_transitions")
}

// ------------------------------------------------------------------------------
// I. Audit Events
// ------------------------------------------------------------------------------

model AuditEvent {
  id                 String   @id @default(uuid())
  tenantId           String? // Null indicates platform-wide administrative event
  actorIdentifier    String? // Identity/role label without fabricating auth session
  action             String // e.g. "POLICY_CREATED", "TRANSITION_PROPOSED", "AUTH_LOGIN_SUCCESS"
  targetEntityType   String // e.g. "DeceptionPolicy", "User", "Session"
  targetEntityId     String
  timestamp          DateTime @default(now())
  correlationId      String?
  structuredMetadata Json // Audit details; append-only semantics

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([timestamp])
  @@index([correlationId])
  @@map("audit_events")
}

// ------------------------------------------------------------------------------
// J. Identity, Tenancy Membership & Sessions (Stage 3C)
// ------------------------------------------------------------------------------

model User {
  id                  String    @id @default(uuid())
  email               String    @unique
  name                String
  passwordHash        String // Argon2id cryptographic hash
  status              String    @default("ACTIVE") // ACTIVE, SUSPENDED, DISABLED
  isPlatformAdmin     Boolean   @default(false) // Explicit platform admin privilege flag
  lastLoginAt         DateTime?
  failedLoginAttempts Int       @default(0)
  lockoutUntil        DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  memberships TenantMembership[]
  sessions    Session[]

  @@index([email])
  @@map("users")
}

model TenantMembership {
  id          String   @id @default(uuid())
  userId      String
  tenantId    String
  role        String   @default("APPLICATION_OWNER") // APPLICATION_OWNER, SECURITY_ANALYST
  permissions Json // Explicit permissions e.g. ["view:applications", "manage:policies"]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId]) // Enforces exactly one membership role record per user-tenant pair
  @@index([tenantId])
  @@index([userId])
  @@map("tenant_memberships")
}

model Session {
  id           String    @id @default(uuid())
  sessionToken String    @unique // 256-bit cryptographically secure hex token
  csrfToken    String // Associated anti-CSRF token
  userId       String
  expiresAt    DateTime
  lastActiveAt DateTime  @default(now())
  revokedAt    DateTime?
  userAgent    String?
  ipAddress    String?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionToken])
  @@index([expiresAt])
  @@map("sessions")
}

// ------------------------------------------------------------------------------
// K. Behavioral Features and Time-Windowed Aggregates (Stage 4B)
// ------------------------------------------------------------------------------

model BehavioralFeatureSet {
  id                    String   @id @default(uuid())
  tenantId              String
  applicationId         String?
  sessionRef            String // Ephemeral pseudonymous or trusted session identifier
  windowLabel           String // e.g. "30s", "5m", "15m"
  windowDurationSeconds Int // 30, 300, 900
  windowStart           DateTime
  windowEnd             DateTime
  observationCount      Int // Number of raw observations contributing to features
  features              Json // Structured dictionary of normalized behavioral features
  schemaVersion         String   @default("1.0.0")
  extractionVersion     String   @default("1.0.0")
  qualityMetadata       Json // Completeness, missing data counts, persistence breakdown
  sourceObservationIds  Json // Array of source SecurityObservation UUIDs
  createdAt             DateTime @default(now())

  tenant      Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  application ProtectedApplication? @relation(fields: [applicationId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@unique([tenantId, applicationId, sessionRef, windowLabel, windowEnd])
  @@index([tenantId])
  @@index([applicationId])
  @@index([sessionRef])
  @@index([windowEnd])
  @@map("behavioral_feature_sets")
}

model BehavioralBaseline {
  id                String    @id @default(uuid())
  tenantId          String
  applicationId     String?
  baselineVersion   String    @default("1.0.0")
  status            String    @default("CALIBRATING") // CALIBRATING, ESTABLISHED, SUPERSEDED
  observationCount  Int       @default(0)
  sampleWindowHours Int       @default(24)
  metrics           Json // Statistical baseline values (request rate, diversity, failure ratios, intervals)
  establishedAt     DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  tenant      Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  application ProtectedApplication? @relation(fields: [applicationId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@unique([tenantId, applicationId, baselineVersion])
  @@index([tenantId])
  @@index([applicationId])
  @@map("behavioral_baselines")
}

// ------------------------------------------------------------------------------
// L. Hybrid Behavioral Detection Engine (Stage 4C)
// ------------------------------------------------------------------------------

model DetectionModelVersion {
  id                   String    @id @default(uuid())
  tenantId             String
  applicationId        String
  modelIdentifier      String // e.g. "model-iforest-app-01-v1"
  version              Int       @default(1)
  algorithm            String // "ISOLATION_FOREST", "STATISTICAL_MAD"
  status               String    @default("READY") // NOT_TRAINED, TRAINING, READY, INSUFFICIENT_TRAINING_DATA, FAILED, STALE, DISABLED
  hyperparameters      Json // { numTrees: 50, sampleSize: 128, contamination: 0.05, ... }
  modelArtifact        Json // Serialized trees or robust statistics + scaling metadata
  featureSchemaVersion String    @default("1.0.0")
  featureList          Json // Array of feature names included in model
  trainingSampleCount  Int
  trainingPeriodStart  DateTime?
  trainingPeriodEnd    DateTime?
  decisionThreshold    Float     @default(0.60)
  evaluationMetrics    Json? // Validation metrics e.g. { precision: ..., recall: ... }
  trainedAt            DateTime  @default(now())
  expiresAt            DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  tenant       Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  application  ProtectedApplication @relation(fields: [applicationId, tenantId], references: [id, tenantId], onDelete: Cascade)
  trainingRuns ModelTrainingRun[]

  @@unique([tenantId, applicationId, version])
  @@index([tenantId])
  @@index([applicationId])
  @@index([status])
  @@map("detection_model_versions")
}

model ModelTrainingRun {
  id                 String    @id @default(uuid())
  tenantId           String
  applicationId      String
  modelVersionId     String?
  algorithm          String    @default("ISOLATION_FOREST")
  status             String    @default("IN_PROGRESS") // IN_PROGRESS, COMPLETED, FAILED, INSUFFICIENT_DATA
  sampleCount        Int       @default(0)
  trainingDurationMs Int?
  errorMessage       String?
  evaluationMetrics  Json?
  initiatedBy        String? // User email or service identifier
  startedAt          DateTime  @default(now())
  completedAt        DateTime?

  tenant       Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  application  ProtectedApplication   @relation(fields: [applicationId, tenantId], references: [id, tenantId], onDelete: Cascade)
  modelVersion DetectionModelVersion? @relation(fields: [modelVersionId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([applicationId])
  @@index([status])
  @@index([startedAt])
  @@map("model_training_runs")
}

model DetectionRuleVersion {
  id                 String   @id @default(uuid())
  tenantId           String? // Null indicates platform-wide default rule
  ruleIdentifier     String // e.g. "RULE_AUTH_FAILURES", "RULE_ENDPOINT_ENUM"
  version            Int      @default(1)
  name               String
  description        String
  enabled            Boolean  @default(true)
  severity           String   @default("HIGH") // LOW, MEDIUM, HIGH, CRITICAL
  conditions         Json // Target window, threshold parameters
  thresholdOverrides Json? // Tenant/app specific threshold overrides
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([ruleIdentifier, version, tenantId])
  @@index([tenantId])
  @@index([ruleIdentifier])
  @@map("detection_rule_versions")
}

// ------------------------------------------------------------------------------
// J. Adaptive Deception Runtime Architecture & Execution Safety (Stage 5B.1)
// ------------------------------------------------------------------------------

model DeceptionExecutionAuthorization {
  id                       String    @id @default(uuid())
  tenantId                 String
  applicationId            String?
  policyDecisionId         String
  dsgGraphId               String
  dsgGraphVersion          Int
  selectedStrategyId       String?
  requestingOperatorId     String?
  requestingOperatorEmail  String?
  requestingOperatorRole   String?
  approvingOperatorId      String?
  approvingOperatorEmail   String?
  authorizationStatus      String    @default("PENDING") // PENDING, APPROVED, DENIED, EXPIRED, REVOKED
  authorizationReasonCodes Json      // Array of reason codes
  decisionRationale        String?
  requestedAt              DateTime  @default(now())
  authorizedAt             DateTime?
  expiresAt                DateTime
  evaluatorVersion         String    @default("5B.1")
  idempotencyKey           String?
  requestPayloadHash       String?
  revocationReason         String?
  revokedAt                DateTime?
  revokedBy                String?
  metadata                 Json?

  tenant           Tenant                        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  application      ProtectedApplication?         @relation(fields: [applicationId, tenantId], references: [id, tenantId], onDelete: Cascade)
  policyDecision   PolicyDecision                @relation(fields: [policyDecisionId, tenantId], references: [id, tenantId], onDelete: Cascade)
  graph            DeceptionGraph                @relation(fields: [dsgGraphId, tenantId], references: [id, tenantId], onDelete: Cascade)
  environments     DeceptionRuntimeEnvironment[]
  executionEvents  DeceptionExecutionEvent[]
  runtimeMutations DeceptionRuntimeMutation[]

  @@unique([id, tenantId])
  @@index([tenantId])
  @@index([applicationId])
  @@index([policyDecisionId])
  @@index([dsgGraphId])
  @@index([authorizationStatus])
  @@index([idempotencyKey])
  @@map("deception_execution_authorizations")
}

model DeceptionRuntimeEnvironment {
  id                      String    @id @default(uuid())
  tenantId                String
  applicationId           String?
  authorizationId         String
  environmentIdentifier   String    // e.g. "env-rt-apex-01"
  name                    String
  lifecycleState          String    @default("AUTHORIZED") // DRAFT, VALIDATING, REJECTED, AUTHORIZED, PROVISIONING, ACTIVE, UPDATING, DEGRADED, TERMINATING, TERMINATED, FAILED, EXPIRED
  statusReason            String?
  dsgGraphId              String
  dsgGraphVersion         Int
  strategyIdentifier      String?
  allocatedCpu            Float     @default(0.5)
  allocatedMemoryMb       Int       @default(256)
  allocatedStorageMb      Int       @default(512)
  networkIsolationMode    String    @default("SANDBOX_ISOLATED") // SANDBOX_ISOLATED, STRICT_AIRGAP
  ingressPort             Int?
  syntheticStateSnapshot  Json?     // Mock routes, identities, schema snapshot
  isSimulated             Boolean   @default(true) // Invariant: true in Stage 5B.1
  executionEvidenceStatus String    @default("MISSING") // Invariant: strictly MISSING in Stage 5B.1
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  expiresAt               DateTime?
  terminatedAt            DateTime?

  tenant        Tenant                          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  application   ProtectedApplication?          @relation(fields: [applicationId, tenantId], references: [id, tenantId], onDelete: Cascade)
  authorization DeceptionExecutionAuthorization @relation(fields: [authorizationId, tenantId], references: [id, tenantId], onDelete: Cascade)
  graph         DeceptionGraph                  @relation(fields: [dsgGraphId, tenantId], references: [id, tenantId], onDelete: Cascade)
  events        DeceptionExecutionEvent[]
  mutations     DeceptionRuntimeMutation[]

  @@unique([id, tenantId])
  @@unique([tenantId, environmentIdentifier])
  @@index([tenantId])
  @@index([applicationId])
  @@index([authorizationId])
  @@index([lifecycleState])
  @@map("deception_runtime_environments")
}

model DeceptionExecutionEvent {
  id              String    @id @default(uuid())
  tenantId        String
  authorizationId String?
  environmentId   String?
  eventType       String    // AUTHORIZATION_REQUESTED, AUTHORIZATION_APPROVED, AUTHORIZATION_DENIED, AUTHORIZATION_REVOKED, AUTHORIZATION_EXPIRED, PROVISIONING_REQUESTED, PROVISIONING_FAILED, ENVIRONMENT_HEALTH_VERIFIED, DSG_TRANSITION_APPLIED, DSG_TRANSITION_REJECTED, ENVIRONMENT_TERMINATED, CLEANUP_COMPLETED
  severity        String    @default("INFO") // INFO, WARN, ERROR, CRITICAL
  message         String
  actorIdentifier String?
  actorRole       String?
  outcomeStatus   String    @default("RECORDED") // RECORDED, REJECTED, UNVERIFIED, CONFIRMED
  evidenceStatus  String    @default("MISSING") // Invariant: strictly MISSING for Stage 5B.1
  eventPayload    Json?
  recordedAt      DateTime  @default(now())

  tenant        Tenant                           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  authorization DeceptionExecutionAuthorization? @relation(fields: [authorizationId, tenantId], references: [id, tenantId], onDelete: Cascade)
  environment   DeceptionRuntimeEnvironment?     @relation(fields: [environmentId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@index([tenantId])
  @@index([authorizationId])
  @@index([environmentId])
  @@index([eventType])
  @@index([recordedAt])
  @@map("deception_execution_events")
}

model DeceptionResourceQuota {
  id                            String    @id @default(uuid())
  tenantId                      String
  applicationId                 String?
  maxActiveEnvironments         Int       @default(3)
  maxCpuAllocation              Float     @default(2.0)
  maxMemoryMb                   Int       @default(1024)
  maxStorageMb                  Int       @default(2048)
  maxEnvironmentLifetimeMinutes Int       @default(120)
  maxConcurrentProvisioning     Int       @default(1)
  maxNetworkConnections         Int       @default(50)
  maxExecutionRequestsPerHour   Int       @default(20)
  isCapacityTracked             Boolean   @default(false)
  capacityStatus                String    @default("UNKNOWN") // UNKNOWN, NORMAL, CONSTRAINED, EXHAUSTED
  currentActiveEnvironments     Int       @default(0)
  currentAllocatedCpu           Float     @default(0.0)
  currentAllocatedMemoryMb      Int       @default(0)
  createdAt                     DateTime  @default(now())
  updatedAt                     DateTime  @updatedAt

  tenant      Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  application ProtectedApplication?  @relation(fields: [applicationId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@unique([tenantId, applicationId])
  @@index([tenantId])
  @@index([applicationId])
  @@map("deception_resource_quotas")
}

model DeceptionRuntimeMutation {
  id                 String    @id @default(uuid())
  tenantId           String
  authorizationId    String
  environmentId      String
  dsgGraphId         String
  baseGraphVersion   Int
  targetGraphVersion Int
  mutationType       String    // TOPOLOGY_EXPANSION, CREDENTIAL_MUTATION, SCHEMA_MUTATION, ISOLATION_UPDATE
  mutationStatus     String    @default("PROPOSED") // PROPOSED, VALIDATED, REJECTED, SUPERSEDED
  syntheticDiff      Json?
  rejectionReason    String?
  idempotencyKey     String?
  appliedAt          DateTime?
  proposedAt         DateTime  @default(now())

  tenant        Tenant                          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  authorization DeceptionExecutionAuthorization @relation(fields: [authorizationId, tenantId], references: [id, tenantId], onDelete: Cascade)
  environment   DeceptionRuntimeEnvironment     @relation(fields: [environmentId, tenantId], references: [id, tenantId], onDelete: Cascade)
  graph         DeceptionGraph                  @relation(fields: [dsgGraphId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@index([tenantId])
  @@index([authorizationId])
  @@index([environmentId])
  @@index([dsgGraphId])
  @@index([mutationStatus])
  @@index([idempotencyKey])
  @@map("deception_runtime_mutations")
}
