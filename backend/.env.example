# ==============================================================================
# Adaptive Deception Gateway Backend - Environment Configuration Template
# ==============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# DO NOT commit real secrets, API keys, or production credentials to Git.
# Note: Stage 3A establishes the core server; Stage 3B introduces PostgreSQL persistence.
# ML detection credentials and reverse proxy routing are non-goals for this stage.
# ==============================================================================

# Node runtime environment (development | production | test)
NODE_ENV=development

# Network bind configuration
HOST=127.0.0.1
PORT=4000

# Logging severity threshold (debug | info | warn | error)
LOG_LEVEL=info

# Allowed frontend origins for CORS (comma-separated, no wildcards allowed)
# In local development, the Vite frontend runs on http://localhost:3000
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Maximum request body size for JSON parsing (e.g., 100kb, 50kb)
BODY_LIMIT=100kb

# PostgreSQL Database Connection URL (Stage 3B+)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Example local development configuration:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/adaptive_deception_dev?schema=public

# Session & Authentication Configuration (Stage 3C+)
# Cryptographic secret for signing session contexts in production (min 32 chars)
SESSION_SECRET=dev-session-secret-must-be-at-least-32-chars-long!
SESSION_TTL_HOURS=24
COOKIE_NAME=adg_session

# Gateway Internal Service Authentication (Stage 4A+)
GATEWAY_INTERNAL_TOKEN=dev-internal-gateway-token-secret-min32chars!
