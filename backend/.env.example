# ==============================================================================
# Adaptive Deception Gateway Backend - Environment Configuration Template
# ==============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# DO NOT commit real secrets, API keys, or production credentials to Git.
# Note: Stage 3A establishes the core server; database and ML detection credentials
# are non-goals for this stage and are deliberately omitted.
# ==============================================================================

# Node runtime environment (development | production | test)
NODE_ENV=development

# Network bind configuration
HOST=127.0.0.1
PORT=4000

# Logging severity threshold (debug | info | warn | error)
LOG_LEVEL=info

# Allowed frontend origins for CORS (comma-separated, no wildcards allowed)
# In local development, the Vite frontend runs on http://localhost:3000
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Maximum request body size for JSON parsing (e.g., 100kb, 50kb)
BODY_LIMIT=100kb
